# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Leave VITE_BACKEND_URL empty. Vite proxy forwards /api/* and socket.io to localhost:5000.
VITE_BACKEND_URL=

# ─── PRODUCTION ───────────────────────────────────────────────────────────────
# Set this to your deployed backend URL (no trailing slash):
# VITE_BACKEND_URL=https://your-backend-service.onrender.com
