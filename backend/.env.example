PORT=5000

# CRITICAL: Must be "production" for HTTPS auth cookies (SameSite=None; Secure) to work in deployed environments
NODE_ENV=production

MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# Comma-separated list of frontend origins allowed to call this backend
# Example: https://your-frontend.vercel.app,https://your-frontend2.netlify.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173
