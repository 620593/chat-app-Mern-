PORT=5000

# "development" for local, "production" for deployed (affects cookie SameSite/Secure flags)
NODE_ENV=development

MONGO_DB_URL=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this backend.
# LOCAL: http://localhost:3000,http://localhost:5173
# PRODUCTION: Add your Vercel/Netlify frontend URL (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
